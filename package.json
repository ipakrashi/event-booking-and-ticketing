{
    "name": "event-booking-and-ticketing",
    "version": "1.0.0",
    "description": "Multi-Vendor Event Booking & Ticketing Platform",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "backend": "npm run dev --prefix backend",
        "frontend": "npm run dev --prefix frontend",
        "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" --kill-others \"npm run backend\" \"npm run frontend\"",
        "test": "npm run test --prefix backend",
        "build": "npm install --prefix backend && npm install --prefix frontend --include=dev && npm run build --prefix frontend",
        "start": "node backend/server.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ipakrashi/event-booking-and-ticketing.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/ipakrashi/event-booking-and-ticketing/issues"
    },
    "homepage": "https://github.com/ipakrashi/event-booking-and-ticketing#readme",
    "dependencies": {
        "concurrently": "^10.0.5",
        "nodemailer": "^10.0.10"
    }
}
